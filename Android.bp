java_defaults {
    name: "glyph_app_defaults",

    certificate: "platform",
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,

    resource_dirs: [],
}

android_library {
    name: "ParanoidGlyph-core",
    platform_apis: true,

    srcs: [
        "src/**/*.kt"
    ],

    static_libs: [
        "androidx.core_core",
        "SettingsLib",
        "IGlyphService-java",
        "androidx.activity_activity-compose",
        "androidx.compose.runtime_runtime",
        "androidx.compose.ui_ui",
        "androidx.compose.foundation_foundation",
        "androidx.compose.material3_material3",
        "androidx.compose.material_material-icons-core",
        "androidx.compose.material_material-icons-extended",
        "androidx.lifecycle_lifecycle-runtime-compose",
    ],
}

android_app {
    name: "ParanoidGlyphPhone1",

    defaults: ["glyph_app_defaults"],

    resource_dirs: [
        "res",
        "phone1/res",
    ],
    asset_dirs: [
        "phone1/assets",
    ],

    static_libs: [
        "ParanoidGlyph-core",
    ],

    required: [
        "privapp_whitelist_co.aospa.glyph.xml",
        "whitelist_co.aospa.glyph.xml",
    ],
}

android_app {
    name: "ParanoidGlyphPhone2",

    defaults: ["glyph_app_defaults"],

    resource_dirs: [
        "res",
        "phone2/res",
    ],
    asset_dirs: [
        "phone2/assets",
    ],

    static_libs: [
        "ParanoidGlyph-core",
    ],

    required: [
        "privapp_whitelist_co.aospa.glyph.xml",
        "whitelist_co.aospa.glyph.xml",
    ],
}

prebuilt_etc {
    name: "privapp_whitelist_co.aospa.glyph.xml",
    src: "permissions/privapp_whitelist_co.aospa.glyph.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "whitelist_co.aospa.glyph.xml",
    src: "permissions/whitelist_co.aospa.glyph.xml",
    sub_dir: "sysconfig",
    system_ext_specific: true,
}
